<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Earmatch.App</RootNamespace>
    <AssemblyName>Earmatch</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="BuildsOnMacOSForChecksAndRunsOnlyOnWindows">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Label="PerMonitorV2DpiComesFromTheAppManifestNotFromWindowsFormsCode">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="WindowsFormsOnlyForTheTrayIcon">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Label="WindowsFormsOnlyForTheTrayIcon">
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup Label="AppMainRunsTheVelopackHooksBeforeWpfStarts">
    <StartupObject>Earmatch.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup Label="AppMainRunsTheVelopackHooksBeforeWpfStarts">
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Earmatch.Core\Earmatch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <EarmatchInfoPlist>$(MSBuildThisFileDirectory)..\..\..\Support\Info.plist</EarmatchInfoPlist>
  </PropertyGroup>

  <Target Name="EarmatchBuildNumber" BeforeTargets="GetAssemblyAttributes" Condition="Exists('$(EarmatchInfoPlist)')">
    <XmlPeek XmlInputPath="$(EarmatchInfoPlist)" Query="/plist/dict/key[.='CFBundleVersion']/following-sibling::string[1]/text()" ProhibitDtd="false">
      <Output TaskParameter="Result" PropertyName="EarmatchBuildNumber" />
    </XmlPeek>
    <ItemGroup Condition="'$(EarmatchBuildNumber)' != ''">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildNumber</_Parameter1>
        <_Parameter2>$(EarmatchBuildNumber)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
