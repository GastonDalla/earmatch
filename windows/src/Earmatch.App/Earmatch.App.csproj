<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon (NotifyIcon); its global usings would clash with WPF's types. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the app build on macOS for checks; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Earmatch.App</RootNamespace>
    <AssemblyName>Earmatch</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- App.Main runs Velopack's install, update and uninstall hooks before WPF starts (App.xaml is a Page, not the
         ApplicationDefinition that would generate a Main of its own). -->
    <StartupObject>Earmatch.App.App</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO0003 asks WinForms apps to set DPI in code; this is a WPF app, which takes Per-Monitor V2 from app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Earmatch.Core\Earmatch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <EarmatchInfoPlist>$(MSBuildThisFileDirectory)..\..\..\Support\Info.plist</EarmatchInfoPlist>
  </PropertyGroup>

  <Target Name="EarmatchBuildNumber" BeforeTargets="GetAssemblyAttributes" Condition="Exists('$(EarmatchInfoPlist)')">
    <XmlPeek XmlInputPath="$(EarmatchInfoPlist)" Query="/plist/dict/key[.='CFBundleVersion']/following-sibling::string[1]/text()" ProhibitDtd="false">
      <Output TaskParameter="Result" PropertyName="EarmatchBuildNumber" />
    </XmlPeek>
    <ItemGroup Condition="'$(EarmatchBuildNumber)' != ''">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildNumber</_Parameter1>
        <_Parameter2>$(EarmatchBuildNumber)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
